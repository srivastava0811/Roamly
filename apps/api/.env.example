# Backend Environment Settings
ROAMLY_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
API_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:8081","exp://localhost:8081"]

# Database connection
# Default local dev uses lightweight SQLite
DATABASE_URL=sqlite+aiosqlite:///./roamly_dev.db
# Production Supabase PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# Supabase Auth
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Provider Mode (mock or live)
PROVIDER_MODE=mock
