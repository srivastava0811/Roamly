# ==============================================================================
# Roamly Root Environment Configuration Template
# NOTE: Do NOT put sensitive secrets or production keys here.
# Copy this to .env or app-specific .env files for local development.
# ==============================================================================

# Node Environment
NODE_ENV=development

# Web Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# Mobile Application
EXPO_PUBLIC_API_URL=http://localhost:8000

# Backend FastAPI Service
ROAMLY_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
API_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:8081","exp://localhost:8081"]

# Database Configuration (Development default: SQLite or local Supabase/PostgreSQL)
DATABASE_URL=sqlite+aiosqlite:///./roamly_dev.db
# For production Supabase PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Supabase Auth & Realtime
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Provider Toggles & Keys (All optional during early development)
# Providers default to mock/offline fixtures if keys are omitted.
PROVIDER_MODE=mock
OPENMETEO_ENABLED=true
NOMINATIM_ENABLED=true
OSRM_ENABLED=true

# AI Inference (LangGraph / Gemini API - strictly server-side)
# Model verification and quota management handled in backend gateway
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
